POSTGRES_DB=briefs
POSTGRES_USER=briefs
POSTGRES_PASSWORD=briefs_dev_password
DATABASE_URL=postgresql+psycopg://briefs:briefs_dev_password@postgres:5432/briefs
JWT_SECRET=replace-this-before-production
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Must be set to `production` on a real deployment: in `development` the API returns the
# email verification code in its own response (`debug_code`) and the CRM cookie is not
# marked Secure. The default is `development`, so forgetting this fails open.
ENVIRONMENT=development
# Dev: письма перехватывает Mailpit из docker-compose, смотреть на http://localhost:8025
# Prod: заменить на SMTP провайдера (порт 587, STARTTLS включается автоматически).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=BRIEFS <no-reply@your-domain.com>
# Public URL of the storefront: used for CORS and Stripe success/cancel redirects.
STOREFRONT_URL=http://localhost:3000
# Stripe test keys live in the dashboard under Developers → API keys.
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:8000/api/v1/payments/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=uah
